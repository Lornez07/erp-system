# Supabase environment variables — copy this file to `.env` and fill in the values.
# Never commit `.env` (it is git-ignored). Find both values in:
# Supabase Dashboard → Project Settings → API.
# This app uses the anon (public) key only — never expose the service-role key in a browser app.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
